# Godot
.godot/
*.translation

# build output, test logs and captures (tools/run_tests.sh, tools/build/*)
/build/**
!/build/*/
!/build/.gdignore
!/build/*/.gitkeep
/_shots/

# Epic Online Services: SECRET — never commit (see eos_credentials.example.cfg)
eos_credentials.cfg

# EOSG plugin binaries (Epic SDK + compiled plugin): installed per machine,
# see addons/epic-online-services-godot/bin/README.md
addons/epic-online-services-godot/bin/*
!addons/epic-online-services-godot/bin/README.md

# OS / editor junk
.DS_Store
Thumbs.db
*.tmp
.vscode/
.idea/
